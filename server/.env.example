# ─── Server settings ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# The address people open in the browser (used in email links)
APP_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/planet_ecosystem

# ─── Secrets: generate with `npm run secrets` ──────────────────────
JWT_SECRET=
ENCRYPTION_KEY=

# Hours a login stays valid
SESSION_HOURS=12
# Set to 1 when running behind Nginx or another reverse proxy
TRUST_PROXY=0
# Production sends the login cookie over HTTPS only. Leave this commented out.
# Uncomment ONLY to test production mode on a plain-HTTP internal IP address:
# COOKIE_SECURE=false

# ─── Email (leave SMTP_HOST empty in development) ──────────────────
# Without SMTP, emails are saved to server/storage/outbox
# and listed at http://localhost:4000/dev/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Planet Ecosystem Careers <careers@example.com>

# ─── Alpha admin (used once by `npm run create-alpha`) ─────────────
# After the account is created, DELETE the password line.
ALPHA_ADMIN_NAME=Alpha Admin
ALPHA_ADMIN_EMAIL=
ALPHA_ADMIN_PASSWORD=
