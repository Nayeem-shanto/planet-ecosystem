{
  "name": "planet-ecosystem",
  "private": true,
  "version": "1.0.0",
  "description": "Planet Ecosystem careers portal — a Sandhani Group sister concern",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "create-alpha": "npm run create-alpha -w server",
    "secrets": "npm run secrets -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": { "node": ">=20.19" }
}
